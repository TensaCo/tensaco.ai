# Copy to .env.local (development) or .env.prod (production values). Both are gitignored; only this file is committed.
# Production values also live as Worker secrets: `npx wrangler secret put <NAME>` in apps/account (and apps/tensaco).

# Resend (https://resend.com) — transactional email from tensaco.ai (domain verified in Resend, us-east-1)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="TensaCo <no-reply@tensaco.ai>"
EMAIL_REPLY_TO=hello@tensaco.ai

# Public URLs
ACCOUNT_URL=https://account.tensaco.ai
SITE_URL=https://tensaco.ai
